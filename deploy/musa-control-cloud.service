# Template: __USER__, __HOME__ and __NODE__ are filled in at install time.
[Unit]
Description=Musa Control Cloud (accounts, relay, push for public users; served at /control-cloud by Caddy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__HOME__/musa-control/cloud
Environment=HOME=__HOME__
ExecStart=__NODE__ --no-warnings src/main.js
Restart=on-failure
RestartSec=3
# Hardened: it never needs to touch the rest of the VPS. It reads its code and
# config, and writes only its own data folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__HOME__/.local/share/musa-control-cloud
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
