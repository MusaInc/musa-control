# Template: __USER__, __HOME__ and __NODE__ are filled in at install time.
[Unit]
Description=Musa Control gateway (iPad workstation API; served at /control by Caddy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__HOME__/musa-control/server
Environment=HOME=__HOME__
Environment=PATH=__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=__NODE__ --no-warnings src/main.js
Restart=on-failure
RestartSec=3
# Agents, builds and tmux sessions it starts must outlive gateway restarts.
KillMode=process
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
